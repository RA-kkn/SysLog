# Load these variables in the API/listener environment. Python does not auto-load .env.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=syslog_db
CLICKHOUSE_USER=syslog
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false
LISTEN_HOST=0.0.0.0
LISTEN_PORT=514
NUM_WORKERS=1
BATCH_MAX_ROWS=2000
BATCH_MAX_SECONDS=1
QUEUE_SIZE=50000
SPOOL_MAX_BYTES=1073741824
RETENTION_DAYS=365
EXPORT_LIMIT=50000
COOKIE_SECURE=true
DISPLAY_TIMEZONE=UTC

# Optional native Linux UDP batching; compile _udp_batch.so first (docs/UDP_BURSTS.md).
UDP_RECEIVE_MODE=auto
UDP_BATCH_SIZE=64
